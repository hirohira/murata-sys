# Google ドライブ連携（共有ドライブ＋サービスアカウント）
# 1. Google Cloud でサービスアカウントを作成し、Google Drive API を有効化、JSONキーを発行
# 2. MURATA の共有ドライブにサービスアカウントのメールを「コンテンツ管理者」で追加
# 3. 現場フォルダを作る場所（共有ドライブ、またはその中のフォルダ）のIDを指定
GOOGLE_SERVICE_ACCOUNT_EMAIL=murata-sys@xxxx.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=0Axxxxxxxxxxxxxxxx
