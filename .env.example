# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxx

# OpenAI API Key (for Whisper speech-to-text)
OPENAI_API_KEY=sk-xxxx

# Anthropic API Key (for Claude report generation)
ANTHROPIC_API_KEY=sk-ant-xxxx

# Google ドライブ連携（どちらか一方の方式を設定。両方あれば A を優先）
# 現場フォルダを作る場所のフォルダID（ドライブでフォルダを開いたときのURL末尾）
GOOGLE_DRIVE_ROOT_FOLDER_ID=1xxxxxxxxxxxxxxxxxxxxx

# A. Googleアカウント（マイドライブ）方式 ― デモ用
#   Google Cloud で Drive API を有効化し、OAuth クライアント（デスクトップ アプリ）を作成。
#   node scripts/google-drive-token.mjs <クライアントID> <シークレット> でトークンを取得する。
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxx

# B. サービスアカウント（共有ドライブ）方式 ― MURATA本番用
#   サービスアカウントを共有ドライブに「コンテンツ管理者」で追加すること。
#   ※ サービスアカウントはマイドライブには保存できない。
# GOOGLE_SERVICE_ACCOUNT_EMAIL=murata-sys@xxxx.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
